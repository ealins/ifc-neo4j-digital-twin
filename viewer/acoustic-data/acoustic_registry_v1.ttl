<https://example.org/hft-acoustic/activity/registry-extraction-2026-08-18> a prov:Activity ;
    dct:description "Transformation of selected VaBDat public record metadata into the thesis prototype RDF registry." ;
    prov:endedAtTime "2026-08-18T00:00:00+02:00"^^xsd:dateTime ;
    prov:used <https://www.vabdat.de/Bauteil/view/346>,
        <https://www.vabdat.de/BauteilKennzahl/view/310> .

<https://example.org/hft-acoustic/component/vabdat-346> a prov:Entity,
        ac:WallAssembly ;
    dct:identifier "vabdat-component-346" ;
    dct:title "B_bGP12_frM75||iMW60_bGP12" ;

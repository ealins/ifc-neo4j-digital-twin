<https://example.org/hft-acoustic/record/vabdat-310> a prov:Entity,
        ac:AcousticPerformanceRecord ;
    dct:hasVersion "prototype-v1" ;
    dct:identifier "vabdat-310" ;
    dct:title "Reference acoustic record for VaBDat component B_bGP12_frM75||iMW60_bGP12" ;
    prov:wasAttributedTo <https://example.org/hft-acoustic/agent/ift-rosenheim> ;
    prov:wasDerivedFrom <https://example.org/hft-acoustic/source/report-vabdat-310>,
        <https://www.vabdat.de/BauteilKennzahl/view/310> ;
    prov:wasGeneratedBy <https://example.org/hft-acoustic/activity/registry-extraction-2026-08-18> ;
    ac:acousticMetric "Rw" ;
    ac:acousticUnit "dB" ;
    ac:dataYear "2022"^^xsd:gYear ;
    ac:describesComponent <https://example.org/hft-acoustic/component/vabdat-346> ;
    ac:methodType "Not explicitly specified in the VaBDat source used for this prototype" ;
    ac:sourceNote "VaBDat notes that the origin of the weighted and frequency-dependent sound reduction values is not specified in the report appendix." ;
    ac:sourceOrganisation <https://example.org/hft-acoustic/agent/ift-rosenheim> ;
    ac:sourceReference "Anhang, Luftschallmessung-Nr. M_25" ;
